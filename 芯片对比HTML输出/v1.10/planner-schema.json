{
  "type": "object",
  "properties": {
    "theme": {
      "type": "object",
      "description": "整站视觉主题。配色每次都要风格迥异、有设计感，不要套模板",
      "properties": {
        "brand_name": { "type": "string", "description": "品牌名(取自Context或按主题起)" },
        "vibe": { "type": "string", "description": "一句话描述本页设计风格/气质，如'暗夜霓虹科技感''莫兰迪温柔治愈''大胆撞色潮流'，每次不同" },
        "colors": {
          "type": "object",
          "description": "配色方案具体色值，按vibe风格自由选择，不要总用蓝紫",
          "properties": {
            "primary": { "type": "string", "description": "主色hex/hsl" },
            "secondary": { "type": "string", "description": "辅色" },
            "accent": { "type": "string", "description": "强调色" },
            "background": { "type": "string", "description": "背景色" },
            "text": { "type": "string", "description": "文字色" }
          },
          "required": ["primary", "secondary", "accent", "background", "text"]
        },
        "gradient": { "type": "string", "description": "渐变(可选)，如linear-gradient(...)" }
      },
      "required": ["brand_name", "vibe", "colors"]
    },
    "sections": {
      "type": "array",
      "description": "4-6个区块，布局自主决定，紧凑高密度，禁止大片空白（无空section、不过度留白）",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "layout": { "type": "string", "description": "该区块的布局位置/角色，自由描述(如'顶部吸顶栏''左中右三栏卡片墙''全宽对比表''底部可折叠')" },
          "purpose": { "type": "string", "description": "区块作用/类型，自由描述(如'需求勾选器''智能推荐''方案横评对比''价格计算器')" },
          "heading": { "type": "string", "description": "主标题" },
          "copy": {
            "type": "object",
            "minProperties": 1,
            "description": "文案要点，事实取自Context",
            "properties": {
              "subheading": { "type": "string" },
              "items": {
                "type": "array",
                "description": "内容条目，交互项带可交互属性",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "category": { "type": "string", "description": "分类(筛选/分组用)" },
                    "selected_default": { "type": "boolean", "description": "勾选器用:是否默认勾选" },
                    "impact": { "type": "string", "description": "勾选器/推荐用:勾选影响" },
                    "recommend_condition": { "type": "string", "description": "推荐用:触发条件" },
                    "score_axes": { "type": "object", "description": "对比表用:各维度评分如{价格:8,性能:7}", "additionalProperties": { "type": "number" } }
                  }
                }
              },
              "recommend_rules": { "type": "string", "description": "推荐用:推荐逻辑说明" },
              "compare_axes": { "type": "array", "description": "对比表用:对比维度", "items": { "type": "string" } },
              "cta_button": { "type": "string" }
            }
          },
          "interaction": { "type": "string", "description": "交互行为+与哪个区块联动，纯展示填'无'" }
        },
        "required": ["layout", "purpose", "heading", "copy", "interaction"]
      }
    }
  },
  "required": ["theme", "sections"]
}
