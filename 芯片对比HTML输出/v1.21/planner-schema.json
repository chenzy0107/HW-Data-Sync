{
  "type": "object",
  "description": "单页工具结构大纲。精简版：真实不编造、内容充实、1 个交互",
  "properties": {
    "theme": {
      "type": "object",
      "description": "整站视觉主题——从预设色板中选一组",
      "properties": {
        "brand_name": { "type": "string", "description": "优先取自Context；无明确品牌名时用中性页面标题，不编造公司全称" },
        "style_preset": { "type": "integer", "description": "从以下 5 组预设色板中选 1 组（填编号 1-5）：1=商务蓝(#1e40af/#f8fafc)、2=科技紫(#6d28d9/#0f172a)、3=清新绿(#166534/#f0fdf4)、4=暖橙色(#c2410c/#fff7ed)、5=经典灰(#374151/#f9fafb)", "minimum": 1, "maximum": 5 }
      },
      "required": ["brand_name", "style_preset"]
    },
    "sections": {
      "type": "array",
      "description": "区块（至少 2 个，建议 2-3 个），布局简洁",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "purpose": { "type": "string", "description": "区块作用（如 hero、产品展示、价格对比、问答）" },
          "heading": { "type": "string", "description": "主标题" },
          "copy": {
            "type": "object",
            "minProperties": 1,
            "description": "文案要点，事实取自Context，缺项标'待定'",
            "properties": {
              "subheading": { "type": "string" },
              "items": {
                "type": "array",
                "description": "内容条目，每条须有Context依据，max 4 条",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" },
                    "data_source": { "type": "string", "enum": ["context", "pending"] }
                  },
                  "required": ["title"]
                }
              },
              "cta_button": { "type": "string" }
            }
          },
          "interaction": { "type": "string", "description": "交互行为，纯展示填'无'。整页只规划 1 个交互即可" }
        },
        "required": ["purpose", "heading", "copy", "interaction"]
      }
    }
  },
  "required": ["theme", "sections"]
}
